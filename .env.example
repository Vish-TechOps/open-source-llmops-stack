# llmops-stack / gcp — settings for GCP phases A, B and C
# Copy to .env (cp .env.example .env && chmod 600 .env) and fill in the <...> values.
# .env is git-ignored. Run the scripts from Cloud Shell (gcloud, kubectl, helm, jq, git, envsubst preinstalled).

# ---------------------------------------------------------------------------
# Project and location
# ---------------------------------------------------------------------------
PROJECT_ID=vish-aiops
REGION=us-central1
ZONE=us-central1-a
NETWORK=default
# Regional internal Application LB (the Inference Gateway) needs a proxy-only subnet
# in REGION. a10 creates it if none exists. Pick a /23 not used in your VPC.
PROXY_ONLY_SUBNET_RANGE=192.168.0.0/23

# ---------------------------------------------------------------------------
# GKE cluster (phase A)
# ---------------------------------------------------------------------------
CLUSTER_NAME=llmops
RELEASE_CHANNEL=regular
# system pool: router EPP, kube-system
SYSTEM_MACHINE=e2-standard-4
# model pool: vLLM CPU pods, one per node, tainted so nothing else lands there.
# C3 = Sapphire Rapids with AMX/AVX512-BF16, which vLLM CPU needs for bf16.
MODEL_MACHINE=c3-standard-8
MODEL_NODES_MIN=2
MODEL_NODES_MAX=4          # phase C runs KServe pods beside phase A for a while
# app pool (phase B): Langfuse, LiteLLM, Guardrails, Ragas, KServe controller
APP_MACHINE=e2-standard-8
APP_NODES_MIN=1
APP_NODES_MAX=2

# ---------------------------------------------------------------------------
# llm-d + vLLM (phase A)
# ---------------------------------------------------------------------------
NS_LLMD=llmd
ROUTER_RELEASE=qwen-router
LLMD_BRANCH=release-1.0
ROUTER_CHART_VERSION=v1.0.0
MODEL=Qwen/Qwen3-0.6B
VLLM_CPU_IMAGE=docker.io/vllm/vllm-openai-cpu:v0.31.0
VLLM_REPLICAS=2
# Optional. Qwen3-0.6B is public; a token only avoids Hugging Face rate limits.
HF_TOKEN=
# Requests per workload in the routing comparison (a16). CPU prefill is slow; keep it small.
ROUTING_REQUESTS=8

# ---------------------------------------------------------------------------
# App layer (phase B)
# ---------------------------------------------------------------------------
NS_APP=llmops
NS_LANGFUSE=langfuse
AR_REPO=llmops                       # Artifact Registry Docker repo, created in a10
LANGFUSE_CHART_VERSION=2.2.4         # Langfuse v4 server
CERT_MANAGER_VERSION=v1.20.2
CLICKHOUSE_OPERATOR_VERSION=0.0.8
# Langfuse UI login created at first start (headless init). Password is generated into run/.
LANGFUSE_ADMIN_EMAIL=you@example.com

# LiteLLM: same pinned, checksum-verified wheel as local phase A.
LITELLM_VERSION=1.108.4
LITELLM_SHA256=d51df0a967fb271c943994f8f1e941982d3ceff538298dc2134dcb03ef01b86a
LANGFUSE_SDK_SPEC="langfuse>=4.7,<5"

# Vertex AI (managed path + Ragas judge). Gemini 2.5 was retired on Vertex on 2026-10-20.
# Gemini 3.x models are served from the "global" location.
VERTEX_CHAT_MODEL=gemini-3.5-flash
VERTEX_LOCATION=global
VERTEX_EMBEDDING_MODEL=gemini-embedding-001
VERTEX_EMBEDDING_LOCATION=us-central1

# ---------------------------------------------------------------------------
# KServe (phase C)
# ---------------------------------------------------------------------------
KSERVE_VERSION=v0.21.0
LLMISVC_NAME=qwen3
